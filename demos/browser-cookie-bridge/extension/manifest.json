{
  "manifest_version": 3,
  "name": "Roche Cookie Bridge",
  "short_name": "CookieBridge",
  "version": "0.3.3",
  "description": "把内网应用 SSO 登录后的 cookie 同步到本地 receiver，给 Python 业务脚本复用。",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "webRequest",
    "identity"
  ],
  "host_permissions": [
    "https://roche.service-now.com/*",
    "https://*.roche.com/*",
    "https://github.com/*",
    "https://*.pages.github.io/*",
    "https://example.com/*",
    "http://127.0.0.1/*",
    "https://www.googleapis.com/*",
    "https://www.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://www.xiaohongshu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://roche.csod.com/*",
    "https://*.csod.com/*",
    "https://anypoint.mulesoft.com/*",
    "https://*.mulesoft.com/*",
    "https://sites.google.com/*",
    "https://accounts.google.com/*",
    "https://*.google.com/*",
    "https://google.com/*",
    "https://wd3.myworkday.com/*",
    "https://*.myworkday.com/*",
    "https://www.chs-ihssc.cn/*",
    "https://*.chs-ihssc.cn/*",
    "https://*.sh.gov.cn/*",
    "https://*.gep.com/*",
    "https://*.srpltradeunion.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "<YOUR_CLIENT_ID>.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Bridge",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
