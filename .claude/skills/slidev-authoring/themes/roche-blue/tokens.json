{
  "meta": {
    "name": "Roche Blue",
    "description": "Roche 品牌风格，白底克制配色 + 暗色 section 页，源自 PDALM/Rojectory PDF 视觉分析",
    "colorSchema": "light",
    "fontStyle": "sans"
  },
  "colors": {
    "bg": "#ffffff",
    "bgSection": "#0d0d0d",
    "primary": "#0b41cd",
    "primaryDim": "#1482fa",
    "primaryGlow": "rgba(11, 65, 205, 0.08)",
    "secondary": "#1482fa",
    "warning": "#ed4a0d",
    "accent": "#7ab33a",
    "danger": "#d0021b",
    "text": "#434343",
    "textDim": "#706b69",
    "textOnDark": "#f3f3f3",
    "border": "#e0e0e0",
    "surface": "#f3f3f3",
    "surfaceDark": "#1a1a1a",
    "surfaceBlue": "#bde3ff"
  },
  "typography": {
    "fontSans": "Inter",
    "fontMono": "JetBrains Mono",
    "fontSerif": "Lora",
    "fontCJK": "Noto Sans SC",
    "headingWeight": "600",
    "bodyWeight": "400",
    "fontImport": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,400;0,600;1,400&family=Noto+Sans+SC:wght@300;400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
  },
  "decorations": {
    "borderRadius": "6px",
    "scanlines": false,
    "glowEffect": false,
    "cursorBlink": false,
    "headingPrefix": "",
    "shadow": "0 1px 4px rgba(0,0,0,0.08)"
  },
  "icons": {
    "style": "outline",
    "banned": ["emoji"],
    "libraries": ["carbon", "tabler"]
  },
  "semanticColors": {
    "positive": "accent",
    "negative": "danger",
    "neutral": "primary",
    "highlight": "warning",
    "supplement": "secondary",
    "muted": "textDim"
  }
}
