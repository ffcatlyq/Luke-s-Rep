{
  "meta": {
    "name": "Sketch Light",
    "description": "浅色手绘风格，Caveat 标题字体，与 Excalidraw light mode 协调",
    "colorSchema": "light",
    "fontStyle": "sans-serif"
  },
  "colors": {
    "bg": "#ffffff",
    "primary": "#1e1e1e",
    "primaryDim": "#6b6b6b",
    "primaryGlow": "rgba(30, 30, 30, 0.06)",
    "secondary": "#1971c2",
    "warning": "#e67700",
    "accent": "#9c36b5",
    "danger": "#e03131",
    "text": "#1e1e1e",
    "textDim": "#868e96",
    "border": "#dee2e6",
    "surface": "#f8f9fa"
  },
  "typography": {
    "fontSans": "Inter",
    "fontMono": "JetBrains Mono",
    "fontSerif": "",
    "fontHeading": "Caveat",
    "headingWeight": "700",
    "bodyWeight": "400",
    "fontImport": "https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
  },
  "decorations": {
    "borderRadius": "6px",
    "scanlines": false,
    "glowEffect": false,
    "cursorBlink": false,
    "headingPrefix": "",
    "shadow": ""
  },
  "icons": {
    "style": "outline",
    "banned": [],
    "libraries": ["carbon", "tabler"]
  },
  "semanticColors": {
    "positive": "primary",
    "negative": "danger",
    "neutral": "secondary",
    "highlight": "warning",
    "supplement": "accent",
    "muted": "textDim"
  }
}
