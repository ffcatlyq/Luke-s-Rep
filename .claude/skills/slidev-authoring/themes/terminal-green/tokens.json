{
  "meta": {
    "name": "Terminal Green",
    "description": "赛博朋克终端风格，暗色背景 + 绿色荧光",
    "colorSchema": "dark",
    "fontStyle": "monospace"
  },
  "colors": {
    "bg": "#0d1117",
    "primary": "#39d353",
    "primaryDim": "#238636",
    "primaryGlow": "rgba(57, 211, 83, 0.15)",
    "secondary": "#58a6ff",
    "warning": "#d29922",
    "accent": "#bc8cff",
    "danger": "#f85149",
    "text": "#e6edf3",
    "textDim": "#8b949e",
    "border": "#30363d",
    "surface": "#161b22"
  },
  "typography": {
    "fontSans": "JetBrains Mono",
    "fontMono": "JetBrains Mono",
    "fontSerif": "",
    "headingWeight": "700",
    "bodyWeight": "400",
    "fontImport": "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&display=swap"
  },
  "decorations": {
    "borderRadius": "4px",
    "scanlines": true,
    "glowEffect": true,
    "cursorBlink": true,
    "headingPrefix": "$ ",
    "shadow": ""
  },
  "icons": {
    "style": "monochrome-unicode",
    "banned": ["emoji"],
    "libraries": ["phosphor", "carbon"]
  },
  "semanticColors": {
    "positive": "primary",
    "negative": "danger",
    "neutral": "secondary",
    "highlight": "warning",
    "supplement": "accent",
    "muted": "textDim"
